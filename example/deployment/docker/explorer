ARG GIT_REPO=https://github.com/snowblossomcoin/snowblossom.git
ARG GIT_REF=master

FROM debian:stable AS base
ENV DEBIAN_FRONTEND=noninteractive
# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=863199#23
RUN mkdir -p /usr/share/man/man1

FROM base AS build-image
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get -qq update
RUN apt-get -qq upgrade
RUN apt-get -qq install --no-install-suggests --no-install-recommends \
    gnupg git curl default-jdk-headless wget gcc-14 g++-14 gcc g++
RUN wget https://github.com/bazelbuild/bazelisk/releases/download/v1.29.0/bazelisk-amd64.deb
RUN dpkg -i bazelisk-amd64.deb
ENV USE_BAZEL_VERSION 8.7.0

FROM build-image AS build
ARG GIT_REPO
ARG GIT_REF
WORKDIR /snowblossom
RUN \
git clone ${GIT_REPO} . && \
git checkout ${GIT_REF}
RUN bazel build :ShackletonExplorer_deploy.jar 2>&1
RUN ls -ahl /snowblossom/bazel-bin


FROM base AS runtime-image
RUN \
  apt-get -qq update && \
  apt-get -qq upgrade && \
  apt-get -qq install --no-install-suggests --no-install-recommends \
    default-jre-headless \
    && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

COPY --from=build /snowblossom/bazel-bin/ShackletonExplorer_deploy.jar /snowblossom/

WORKDIR /data
COPY --from=build /snowblossom/example/configs/logging.properties log.conf
COPY --from=build /snowblossom/example/configs/explorer.conf .

VOLUME /data
CMD exec /usr/bin/java ${SNOWBLOSSOM_JAVA_OPTIONS} -jar /snowblossom/ShackletonExplorer_deploy.jar /data/explorer.conf
